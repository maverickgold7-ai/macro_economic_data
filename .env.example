# Copy to .env (read by both the Next.js app and the CLI ingest scripts).

# Optional API keys (public CSV / scrape fallbacks are used when absent)
FRED_API_KEY=
BLS_API_KEY=
BEA_API_KEY=

# Required for /api/refresh (no default; the endpoint returns 503 until set)
REFRESH_SECRET=

# Optional ingest settings
# INGEST_FETCH_TIMEOUT_MS=30000   # per-request timeout
# INGEST_ALLOW_SHRINK=1           # allow a backfill to shrink stored history by >10% (normally refused)

# Investing.com calendar capture (scripts/capture-investing-month.ts)
# INVESTING_HEADLESS=1
# INVESTING_CDP_URL=http://127.0.0.1:9222
